---
const { id, image=[], date, title, text = [], /* weather, */ sticker = [] } = Astro.props;
---

<li id={id}>
  <article>
    <!-- <header class="blogSection__head">
      <span class="blogSection__weather"><img src={weather} alt="" /></span>
    </header> -->
    <div>
      {
        image.length > 1 ? (
          // 2枚以上
          <div class="swiper diary-swiper diary-img">
            <div class="swiper-wrapper">
              {image.map((img) => (
                <div class="swiper-slide">
                  <img src={img.image} alt={img.alt} />
                </div>
              ))}
            </div>

            <div class="swiper-pagination" />

            <button class="swiper-button-prev" />
            <button class="swiper-button-next" />
          </div>
        ) : (
          // 1枚だけ
          <div class="diary-img"><img src={image[0].image} alt={image[0].alt} /></div>
        )
      }
      {
        sticker.map((item) => (
          <span class={`blogSection__sticker blogSection__sticker--${item.class}`}>
            <img src={item.image} alt="" />
          </span>
        ))
      }
    </div>
    <div class="blogSection__ttl">
      <time class="en">{date}</time>
      <h3 class="jp">{title}</h3>
    </div>
    <div class="diary-text">
      {
        text.map((paragraph) => (
          <p>
            {paragraph.map((item) => {
              if (item.type === "strong") {
                return <strong>{item.content}</strong>;
              }

              if (item.type === "link") {
                return (
                  <a href={item.href} target="_blank">
                    {item.content}
                  </a>
                );
              }

              return item.content;
            })}
          </p>
        ))
      }
    </div>
  </article>
</li>
