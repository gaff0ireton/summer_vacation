<section class="blogSection" id="blog">
  <h2>diary</h2>
  <ul>
    {
      diaries.map((diary) => (
        <DiaryCard
          id={diary.id}
          image={diary.image}
          date={diary.date}
          weather={diary.weather}
          title={diary.title}
          text={diary.text}
          sticker={diary.sticker}
        />
      ))
    }

