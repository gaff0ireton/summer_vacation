---
import Layout from "../layouts/Layout.astro";
import Sidebar from "../components/Sidebar.astro";
import MainVisual from "../components/MainVisual.astro";
import Diary from "../components/Diary.astro";
import Profile from "../components/Profile.astro";
import Qa from "../components/Qa.astro";
import Boom from "../components/Boom.astro";
import "../styles/global.css";
import "../styles/global.scss";
---

<Layout title="🌞SUMMER VACATION🌞">
  <main class="main-wrapper">
    <MainVisual />
    <div class="contents-wrapper">
      <Diary />
      <Sidebar />
    </div>

    <aside class="about" id="about">
      <h2>about me</h2>
      <div class="contents-wrapper">
        <Profile />
        <Boom />
        <Qa />
      </div>
    </aside>
  </main>
</Layout>
