---
import Layout from "../layouts/Layout.astro";
import Sidebar from "../components/Sidebar.astro";
import MainVisual from "../components/MainVisual.astro";
import Diary from "../components/Diary.astro";
import Profile from "../components/Profile.astro";
import Qa from "../components/Qa.astro";
import Boom from "../components/Boom.astro";
import "../styles/global.css";
import "../styles/global.scss";
---

<Layout title="🌞SUMMER VACATION🌞">
  <main class="main-wrapper">
    <MainVisual />
    <div class="contents-wrapper">
      <Diary />
      <Sidebar />
    </div>

    <aside class="about is-inview" id="about">
      <h2>about me</h2>
      <div class="contents-wrapper side-end">
        <Profile />
        <Boom />
        <Qa />
      </div>
    </aside>
  </main>
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      // 1. 通常の要素用（50%で発火）
      const standardObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-view");
              standardObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.5 },
      );

      // 2. 振り分け処理
      const targets = document.querySelectorAll(".is-inview");
      targets.forEach((target) => {
        standardObserver.observe(target);
      });

      const smoothScrollTrigger = document.querySelectorAll('a[href^="#"]');

      const header = document.querySelector(".header");

      for (let i = 0; i < smoothScrollTrigger.length; i++) {
        smoothScrollTrigger[i].addEventListener("click", (e) => {
          e.preventDefault();

          const href = smoothScrollTrigger[i].getAttribute("href");
          if (!href) return;

          const targetElement = document.getElementById(href.replace("#", ""));

          if (targetElement) {
            const rect = targetElement.getBoundingClientRect().top;
            const offset = window.scrollY;

            const gap = window.innerWidth <= 750 && header ? header.offsetHeight : 0;

            const target = rect + offset - gap;

            window.scrollTo({
              top: target,
              behavior: "smooth",
            });
          }
        });
      }
    });
  </script>
</Layout>
